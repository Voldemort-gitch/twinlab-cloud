# ============================================================================
# TwinLab — Frontend environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# ============================================================================

# Supabase project URL (Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/publishable key (Dashboard → API → "anon" public).
# Safe to expose to the browser — Row-Level Security restricts what it can
# read/write. Do NOT use the service_role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# URL of the running simulation service (local or deployed)
NEXT_PUBLIC_SIMULATION_SERVICE_URL=http://localhost:3001

# Optional shared secret sent to the simulation service as
# `Authorization: Bearer <token>`. Must match SIM_API_TOKEN on the simulation
# service. Leave blank for local-only development.
NEXT_PUBLIC_SIMULATION_SERVICE_TOKEN=

# ----------------------------------------------------------------------------
# Server-side / script-only variables — NEVER prefix these with NEXT_PUBLIC_,
# otherwise they would be inlined into the browser bundle and exposed.
# ----------------------------------------------------------------------------

# Supabase service-role key (Dashboard → API → "service_role"). KEEP SECRET.
# Required only for local maintenance scripts (npm run seed,
# scripts/reset-admin.js). Not read by the Next.js app itself.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional password used by scripts/reset-admin.js when recreating the demo
# admin. Leave unset to fall back to the default.
ADMIN_PASSWORD=

# ============================================================================
# Simulation service  —  copy to simulation-service/.env (see
# simulation-service/.env.example): SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# PORT, NODE_ENV, SIM_API_TOKEN.
# ============================================================================
