# ============================================================================
# TwinLab — Environment for local maintenance scripts (scripts/*.js, *.ts)
# Copy to scripts/.env.local and fill in real values. Never commit real values.
# ============================================================================

# Supabase project URL (same as the frontend's NEXT_PUBLIC_SUPABASE_URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase service-role key (Dashboard → API → "service_role"). KEEP SECRET.
# Required by npm run seed and scripts/reset-admin.js.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
