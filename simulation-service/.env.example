# TwinLab Simulation Service — environment variables
# Copy to simulation-service/.env and fill in real values.

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key (Settings → API → service_role) — KEEP SECRET, server-side only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Port the service listens on
PORT=3001

# Optional shared secret. When set, /simulation/* endpoints require
# `Authorization: Bearer <SIM_API_TOKEN>`. Match NEXT_PUBLIC_SIMULATION_SERVICE_TOKEN
# on the frontend. Leave blank for local-only development.
SIM_API_TOKEN=

# Node environment (development | production)
NODE_ENV=development
